#!/bin/sh

# Define colors for better visibility
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo "${BLUE}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${NC}"
echo "${BLUE}┃       ${YELLOW}Running pre-commit hooks for Talkie App        ${BLUE}┃${NC}"
echo "${BLUE}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${NC}"

echo "${YELLOW}⏳ Running ESLint to check for linting errors...${NC}"
# First, run just eslint on staged files to check for errors
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.jsx?$')
if [ -n "$STAGED_FILES" ]; then
  echo "${YELLOW}📄 Checking files:${NC}"
  echo "$STAGED_FILES"
  npx eslint $STAGED_FILES
  if [ $? -ne 0 ]; then
    echo "${RED}❌ ESLint found errors in your code.${NC}"
    echo "${YELLOW}📝 Please fix these issues before committing:${NC}"
    echo "    ${GREEN}yarn lint:fix${NC} - to automatically fix some issues"
    exit 1
  else
    echo "${GREEN}✅ ESLint check passed!${NC}"
  fi
fi

echo "${YELLOW}⏳ Running lint-staged for full code checks...${NC}"
# Run lint-staged to run linting, formatting, and tests on staged files
npx lint-staged
exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo "${RED}❌ Pre-commit checks failed!${NC}"
  echo "${YELLOW}📝 Please fix the issues above before committing.${NC}"
  echo "${YELLOW}💡 Tips for fixing common issues:${NC}"
  echo "    ${GREEN}yarn lint:fix${NC} - Fix linting issues"
  echo "    ${GREEN}yarn prettier:fix${NC} - Fix formatting issues"
  echo "    ${GREEN}yarn test${NC} - Run all tests to debug test failures"
  exit 1
else
  echo "${GREEN}✅ All pre-commit checks passed successfully!${NC}"
fi
