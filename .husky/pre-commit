#!/bin/sh

# Define colors for better visibility
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo "${BLUE}┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓${NC}"
echo "${BLUE}┃       ${YELLOW}Running pre-commit hooks for Talkie App        ${BLUE}┃${NC}"
echo "${BLUE}┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛${NC}"

# Create a temp file to capture errors
ERROR_LOG=$(mktemp)

echo "${YELLOW}⏳ Running ESLint to check for linting errors...${NC}"
# First, run just eslint on staged files to check for errors
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.jsx?$')
if [ -n "$STAGED_FILES" ]; then
  echo "${YELLOW}📄 Checking files:${NC}"
  echo "$STAGED_FILES"
  npx eslint $STAGED_FILES 2> $ERROR_LOG
  if [ $? -ne 0 ]; then
    echo "${RED}${BOLD}❌ ESLint FAILED! See errors below:${NC}"
    echo "${RED}▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼${NC}"
    cat $ERROR_LOG
    echo "${RED}▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲${NC}"
    echo "${YELLOW}📝 Common ESLint Error Types:${NC}"
    echo "    ${BOLD}testing-library/no-node-access${NC} - Use Testing Library methods instead of direct DOM access"
    echo "    ${BOLD}no-unused-vars${NC} - Comment out unused variables with /* */ instead of removing them"
    echo "    ${BOLD}testing-library/no-render-in-setup${NC} - Move render calls from beforeEach to individual tests"
    echo ""
    echo "${YELLOW}📝 To fix:${NC}"
    echo "    ${GREEN}yarn lint:fix${NC} - to automatically fix some issues"
    echo "    To skip pre-commit checks (use sparingly): ${GREEN}git commit -m \"your message\" --no-verify${NC}"
    rm $ERROR_LOG
    exit 1
  else
    echo "${GREEN}✅ ESLint check passed!${NC}"
  fi
fi

# DUPLICATE_FILES_CHECK - Detect duplicate files before commit
echo "${YELLOW}⏳ Checking for duplicate files...${NC}"
DUPLICATE_FILES=$(find src -name "* 2.js" -o -name "* 2.jsx")
if [ -n "$DUPLICATE_FILES" ]; then
  echo "${RED}${BOLD}❌ WARNING: Duplicate files detected!${NC}"
  echo "$DUPLICATE_FILES"
  echo "${YELLOW}💡 Run ./cleanup-duplicates.sh to clean these up.${NC}"
  echo "${YELLOW}Continuing with commit, but please clean up these files soon.${NC}"
fi

echo "${YELLOW}⏳ Running lint-staged for full code checks...${NC}"
# Run lint-staged to run linting, formatting, and tests on staged files
npx lint-staged > $ERROR_LOG 2>&1
exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo "${RED}${BOLD}❌ PRE-COMMIT CHECKS FAILED!${NC}"
  echo "${RED}▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼▼${NC}"
  cat $ERROR_LOG
  echo "${RED}▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲▲${NC}"
  echo ""
  echo "${YELLOW}${BOLD}🔍 DEBUGGING TIPS:${NC}"
  echo "1. ${BOLD}For ESLint errors:${NC}"
  echo "   - Run ${GREEN}yarn lint:check${NC} to see all linting errors"
  echo "   - For unused imports: ${BOLD}Comment them out${NC} instead of removing them"
  echo "   - Example: ${GREEN}import { useState /*, useEffect */ } from 'react';${NC}"
  echo ""
  echo "2. ${BOLD}For test failures:${NC}"
  echo "   - Run ${GREEN}yarn test -- path/to/failing/test.js${NC} to see detailed error"
  echo "   - Check for data types (arrays vs objects)"
  echo "   - Ensure DOM selectors match component (use data-testid attributes)"
  echo ""
  echo "3. ${BOLD}To skip pre-commit temporarily:${NC}"
  echo "   ${GREEN}git commit -m \"your message\" --no-verify${NC}"
  echo ""
  rm $ERROR_LOG
  exit 1
else
  echo "${GREEN}✅ All pre-commit checks passed successfully!${NC}"
fi
rm $ERROR_LOG
