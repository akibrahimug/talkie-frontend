{
  "name": "talkie-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@loadable/component": "^5.15.2",
    "@phosphor-icons/react": "^2.1.7",
    "@reduxjs/toolkit": "^1.8.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^0.27.2",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^3.6.1",
    "lodash": "^4.17.21",
    "millify": "^5.0.0",
    "msw": "^0.44.2",
    "react": "^18.2.0",
    "react-app-rewired": "^2.2.1",
    "react-contenteditable": "^3.3.6",
    "react-dom": "^18.2.0",
    "react-icons": "^4.4.0",
    "react-loading-skeleton": "^3.1.0",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "sass": "^1.54.4",
    "socket.io-client": "^4.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "react-app-rewired start",
    "lint:check": "eslint 'src/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' --fix",
    "prettier:check": "prettier --check 'src/**/*.{js,jsx,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{js,jsx,json}'",
    "build": "CI=false react-app-rewired build",
    "test": "react-app-rewired test --coverage --forceExit --detectOpenHandles --watchAll=false",
    "test:changed": "echo '\\033[1;33m🧪 Running tests for changed files...\\033[0m' && react-app-rewired test --findRelatedTests --coverage --forceExit --detectOpenHandles --watchAll=false",
    "test:icons": "react-app-rewired test --testPathPattern=src/components/icons/__tests__ --coverage --forceExit --detectOpenHandles --watchAll=false",
    "prepare": "husky",
    "hooks:pre-commit": "sh .husky/pre-commit",
    "hooks:commit-msg": "sh .husky/commit-msg",
    "test:hooks": "chmod +x ./test-commit-hook.sh && ./test-commit-hook.sh",
    "cleanup:duplicates": "chmod +x ./cleanup-duplicates.sh && ./cleanup-duplicates.sh"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint",
      "prettier --check",
      "yarn test:changed"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "camelcase": "^8.0.0",
    "eslint": "^8.22.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jest": "^26.8.3",
    "eslint-plugin-n": "^15.2.4",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "history": "^5.3.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest-canvas-mock": "^2.4.0",
    "lint-staged": "^15.5.0",
    "prettier": "^2.7.1",
    "react-app-alias": "^2.2.1",
    "redux-mock-store": "^1.5.5"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/test/*.js?(x)",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "moduleNameMapper": {
      "@components/(.*)": [
        "<rootDir>/src/components/$1"
      ],
      "@services/(.*)": [
        "<rootDir>/src/services/$1"
      ],
      "@hooks/(.*)": [
        "<rootDir>/src/hooks/$1"
      ],
      "@mocks/(.*)": [
        "<rootDir>/src/mocks/$1"
      ],
      "@pages/(.*)": [
        "<rootDir>/src/pages/$1"
      ],
      "@redux/(.*)": [
        "<rootDir>/src/redux-toolkit/$1"
      ],
      "@assets/(.*)": [
        "<rootDir>/src/assets/$1"
      ],
      "@colors/(.*)": [
        "<rootDir>/src/colors/$1"
      ],
      "@root/(.*)": [
        "<rootDir>/src/$1"
      ],
      "\\.(css|scss)$": "identity-obj-proxy"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@phosphor-icons)/)"
    ]
  }
}
